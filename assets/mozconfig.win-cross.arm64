# ==========================================
# Vantage Browser - Windows ARM64 Cross-Compile (MSVC via msvc-wine)
# Based on mozconfig.win-cross, target changed to aarch64
# ==========================================

# ---- 目标平台：MSVC 路线 (ARM64) ----
ac_add_options --target=aarch64-pc-windows-msvc

# ---- 启用 mach bootstrap 自动管理 clang-cl / MSVC / Windows SDK ----
ac_add_options --enable-bootstrap

# ---- 应用/品牌 ----
ac_add_options --enable-application=browser
ac_add_options --with-app-name=vantage
ac_add_options --with-branding=browser/branding/vantage

# ---- 构建优化（对齐 mozconfig.new） ----
ac_add_options --enable-release
ac_add_options --disable-debug
ac_add_options --disable-tests
ac_add_options --enable-optimize
ac_add_options --enable-rust-simd
ac_add_options --disable-cargo-incremental
ac_add_options --enable-hardening

# ---- Vantage 隐私定制（对齐 mozconfig.new） ----
ac_add_options --allow-addon-sideload
ac_add_options --disable-crashreporter
ac_add_options --disable-default-browser-agent
ac_add_options --disable-updater
ac_add_options --with-unsigned-addon-scopes=app,system

# ---- Windows 专属：简化构建 ----
ac_add_options --disable-maintenance-service  # Windows 服务，不需要

# ---- 语言包 ----
ac_add_options --with-l10n-base=$PWD/lw/l10n

# ---- clang-cl 插件（Firefox 官方推荐） ----
export ENABLE_CLANG_PLUGIN=1

# ---- 禁用 Mozilla 遥测 ----
export MOZ_REQUIRE_SIGNING=
mk_add_options MOZ_CRASHREPORTER=0
mk_add_options MOZ_DATA_REPORTING=0
mk_add_options MOZ_SERVICES_HEALTHREPORT=0
mk_add_options MOZ_TELEMETRY_REPORTING=0

# ---- ccache（如果可用） ----
# ---- 编译加速 ----
# ---- 编译加速：并行度自适应（2026-09-27）----
# 取「CPU 核数」与「按可用内存估算的任务数」的较小值：实测每个编译任务约 1.1 GiB，
# 这里按 1.5 GiB 估；另留 6 GiB 给链接峰值 / 面板 / 其他进程。内存紧时自动降并行，避免换页拖慢全机。
_vt_cpu=$(nproc 2>/dev/null || echo 4)
_vt_avail=$(awk '/^MemAvailable:/{print int($2/1024)}' /proc/meminfo 2>/dev/null || echo 4096)
[ -n "$_vt_cpu" ] || _vt_cpu=4
[ -n "$_vt_avail" ] || _vt_avail=4096
_vt_mem_jobs=$(( (_vt_avail - 6144) / 1536 )) || :
[ "$_vt_mem_jobs" -ge 2 ] || _vt_mem_jobs=2
if [ "$_vt_cpu" -lt "$_vt_mem_jobs" ]; then _vt_jobs=$_vt_cpu || :; else _vt_jobs=$_vt_mem_jobs || :; fi
[ "$_vt_jobs" -ge 1 ] || _vt_jobs=1
mk_add_options MOZ_PARALLEL_BUILD=$_vt_jobs
unset _vt_cpu _vt_avail _vt_mem_jobs _vt_jobs
# rust 固定 1.94.1（LLVM 与 clang 一致）→ 跨语言 LTO
export RUSTUP_TOOLCHAIN=1.94.1
# LTO：full + 跨语言（Rust <-> C++）
ac_add_options --enable-lto=cross,full
# PGO：复用 Mozilla 官方 profile（缺失则自动跳过，便于随时回退）
# 先跑 scripts/fetch-pgo-profile.sh windows-arm64 生成 ~/.cache/vantage-pgo/win64-aarch64/merged.profdata
VANTAGE_PGO_PROFILE="$HOME/.cache/vantage-pgo/win64-aarch64/merged.profdata"
if [ -f "$VANTAGE_PGO_PROFILE" ]; then
    ac_add_options --enable-profile-use=cross
    ac_add_options --with-pgo-profile-path="$VANTAGE_PGO_PROFILE"
fi

if command -v ccache >/dev/null 2>&1; then
    ac_add_options --with-ccache
fi

# ⚠️ 注意：ARM64 MSVC 路线：
#   - clang-cl / MSVC headers / Windows SDK 都由 --enable-bootstrap 自动管理
#   - 目标设备：Surface Pro X, Snapdragon 笔记本等 Windows ARM64 设备
#   - 完整功能支持（WebRTC ✅、geckodriver ✅）

# ---- MSVC Redistributable（winget 审核必需：安装包内置 VC++ runtime DLL）----
# 自动定位 mach bootstrap 下载的 MSVC Redist CRT 目录（ARM64 目标）
REDIST_DIR="$(ls -d "$HOME/.mozbuild/vs/VC/Redist/MSVC"/*/arm64/Microsoft.VC*.CRT 2>/dev/null | sort -V | tail -1)"
if [ -n "$REDIST_DIR" ]; then
    ac_add_options --with-redist="$REDIST_DIR"
else
    echo "⚠️ 未找到 MSVC Redist CRT 目录（$HOME/.mozbuild/vs/VC/Redist/MSVC/*/arm64/Microsoft.VC*.CRT），--with-redist 跳过"
fi
