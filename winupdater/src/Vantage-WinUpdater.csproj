<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>Vantage-WinUpdater</AssemblyName>
    <RootNamespace>Vantage.WinUpdater</RootNamespace>
    <ApplicationIcon>../Vantage-WinUpdater.ico</ApplicationIcon>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>true</Prefer32Bit>
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <Version>2.0.0</Version>
    <Company>ASYS Technology</Company>
    <Product>Vantage WinUpdater</Product>
    <Description>Vantage Browser auto-updater</Description>
    <Copyright>© 2026 ASYS Technology</Copyright>
    <AssemblyTitle>Vantage WinUpdater</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Management" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
  </ItemGroup>

</Project>
