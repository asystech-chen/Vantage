+   *          be worth segmenting, or null when Range support cannot be
+   *          determined (single-channel fallback).
+   */
+  async _probeRange() {
+    // Try a HEAD request first.  Some servers reject HEAD (405/403), in
+    // which case we fall back to a Range GET probe below.
+    let result = await new Promise(resolve => {
+      let channel = this._createChannel();
+      if (!(channel instanceof Ci.nsIHttpChannel)) {
+        resolve(null);
+        return;
+      }
+      // Register the probe channel so that cancel() can interrupt it: a
+      // download canceled during probing would otherwise stay stuck forever.
+      this._channels.push(channel);
+      let done = false;
+      let timer = null;
+      // Completes the probe without canceling the channel: the probe
+      // response is tiny (empty HEAD body / one-byte range) and letting it
+      // finish naturally keeps the connection clean for the part requests
+      // that follow immediately.  Canceling here races with connection
+      // reuse and can abort the first parts (NS_ERROR_NOT_AVAILABLE when
+      // reading responseStatus on a half-closed channel).
+      let complete = value => {
+        if (done) {
+          return;
+        }
+        done = true;
+        if (timer) {
+          clearTimeout(timer);
+        }
+        let index = this._channels.indexOf(channel);
+        if (index != -1) {
+          this._channels.splice(index, 1);
+        }
+        resolve(value);
+      };
