+  "@mozilla.org/network/background-file-saver;1?mode=streamlistener",
+  "nsIBackgroundFileSaver"
+);
+
+// Default number of parallel parts.  Users can configure this through the
+// "vantage.download.multithread.maxParts" preference (clamped in execute()).
+const kPartCount = 4;
+
+// Files smaller than this are downloaded with a single channel.
+// 500 KB: small enough that parallel parts would not help, while still
+// letting users benefit from faster downloads in good network conditions.
+const kMinSizeThreshold = 500 * 1024;
+
+// Chunk size used when merging part files (controls peak memory usage).
+const kMergeChunkSize = 4 * 1024 * 1024;
