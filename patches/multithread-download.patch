+      // Getters and setters only exist on originAttributes, so it has to be
+      // cloned, changed, and re-set.
+      channel.loadInfo.originAttributes = {
+        ...channel.loadInfo.originAttributes,
+        userContextId: download.source.userContextId,
+      };
+    }
