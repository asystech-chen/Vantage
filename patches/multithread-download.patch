+ * decide whether the final target is just the placeholder created at the
+ * start of the download and can therefore be removed safely.
+ */
+async function isPlaceholder(path) {
+  try {
+    if ((await IOUtils.stat(path)).size == 0) {
+      return true;
+    }
+  } catch (ex) {
+    // Canceling the download may have removed the placeholder already.
+    if (ex.name != "NotFoundError") {
+      console.error(ex);
+    }
+  }
+  return false;
+}
+
+/**
+ * Saver that downloads a file using multiple parallel HTTP Range requests.
+ */
+export var MultiThreadSaver = function () {};
+
+MultiThreadSaver.prototype = {
+  /**
+   * Download object associated with this saver.
+   */
+  download: null,
+
+  /**
+   * True if the download has been canceled.
+   */
+  _canceled: false,
+
+  /**
+   * Currently active channels, canceled by cancel().
+   */
+  _channels: [],
+
+  /**
