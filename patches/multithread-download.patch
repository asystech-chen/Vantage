+    return this._sha256Hash || null;
+  },
+
+  /**
+   * Implements "DownloadSaver.getSignatureInfo".
+   */
+  getSignatureInfo() {
+    return this._signatureInfo || null;
+  },
+
+  /* ---- internal methods ---- */
+
