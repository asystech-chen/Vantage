+    }
+  },
+
+  /**
+   * Implements "DownloadSaver.toSerializable".
+   */
+  toSerializable() {
+    return { type: "multithread" };
+  },
+
+  /**
+   * Implements "DownloadSaver.getSha256Hash".  The hash is only available
+   * when the download used the single-channel fallback (which enables the
