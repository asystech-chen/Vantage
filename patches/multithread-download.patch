+      this._completePath = partFilePath || targetPath + ".part";
+      if (probe.contentType) {
+        aSetPropertiesFn({ contentType: probe.contentType });
+      }
+      if (this._tmpDir) {
+        // Make sure the configured part cache directory exists.  When it
+        // cannot be created (or is not writable), fall back to writing the
+        // part files next to the complete file.
+        try {
+          await IOUtils.makeDirectory(this._tmpDir, {
+            ignoreExisting: true,
+            createAncestors: true,
+          });
+        } catch (ex) {
+          this._tmpDir = "";
