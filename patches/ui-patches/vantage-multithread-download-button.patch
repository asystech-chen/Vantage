diff --git a/browser/components/customizableui/CustomizableWidgets.sys.mjs b/browser/components/customizableui/CustomizableWidgets.sys.mjs
index 5c82bff..c0dd6ce 100644
--- a/browser/components/customizableui/CustomizableWidgets.sys.mjs
+++ b/browser/components/customizableui/CustomizableWidgets.sys.mjs
@@ -24,6 +24,11 @@ ChromeUtils.defineESModuleGetters(lazy, {
 
 const kPrefCustomizationDebug = "browser.uiCustomization.debug";
 
+// Vantage: keeps one preference observer per window for the multi-threaded
+// download toolbar button.  The observer is registered in the widget's
+// onCreated() and removed in onDestroyed().
+const gVantageMultithreadObservers = new Map();
+
 ChromeUtils.defineLazyGetter(lazy, "log", () => {
   let { ConsoleAPI } = ChromeUtils.importESModule(
     "resource://gre/modules/Console.sys.mjs"
@@ -270,6 +275,57 @@ export const CustomizableWidgets = [
       win.SessionWindowUI.restoreLastClosedTabOrWindowOrSession(win);
     },
   },
+  {
+    // Vantage: toggles the multi-threaded download saver
+    // (vantage.download.multithread).  Shown only in the Customize toolbar
+    // palette, so it is placed on a toolbar by the user.
+    id: "vantage-multithread-download-button",
+    l10nId: "vantage-multithread-download-button",
+    _introducedInVersion: 0,
+    onCreated(aNode) {
+      const kPref = "vantage.download.multithread";
+      aNode.setAttribute("type", "checkbox");
+      const updateChecked = () => {
+        let enabled = false;
+        try {
+          enabled = Services.prefs.getBoolPref(kPref, false);
+        } catch (e) {}
+        aNode.toggleAttribute("checked", enabled);
+      };
+      updateChecked();
+      // Keep the button state in sync when the preference is changed
+      // elsewhere, for example from the Vantage preferences page.
+      const observer = {
+        observe(aSubject, aTopic, aData) {
+          if (aData == kPref) {
+            updateChecked();
+          }
+        },
+      };
+      Services.prefs.addObserver(kPref, observer);
+      gVantageMultithreadObservers.set(aNode.ownerDocument, observer);
+    },
+    onCommand(aEvent) {
+      const kPref = "vantage.download.multithread";
+      let enabled = false;
+      try {
+        enabled = Services.prefs.getBoolPref(kPref, false);
+      } catch (e) {}
+      Services.prefs.setBoolPref(kPref, !enabled);
+    },
+    onDestroyed(aDocument) {
+      // CustomizableUI passes the window's document here; drop the observer
+      // that onCreated() registered for it.
+      let observer = gVantageMultithreadObservers.get(aDocument);
+      if (observer) {
+        Services.prefs.removeObserver(
+          "vantage.download.multithread",
+          observer
+        );
+        gVantageMultithreadObservers.delete(aDocument);
+      }
+    },
+  },
   {
     id: "print-button",
     l10nId: "navbar-print",
