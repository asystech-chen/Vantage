+<head>
+  <meta charset="utf-8">
+  <title data-l10n-id="onboarding-window-title"></title>
+  <link rel="localization" href="browser/onboarding.ftl">
+  <link rel="stylesheet" href="chrome://browser/content/onboarding/onboarding.css">
+</head>
+<body>
+
+<div class="app">
+  <header class="topbar">
+    <div class="brand">
+      <img src="chrome://branding/content/icon128.png" alt="">
+      <span data-l10n-id="onboarding-brand"></span>
+      <small data-l10n-id="onboarding-brand-sub"></small>
