+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+"use strict";
+
+const PREF = {
+  theme: "vantage.theme.enabled",
+  nova: "browser.nova.enabled",
+  toolbarTheme: "browser.theme.toolbar-theme",
+  contentTheme: "browser.theme.content-theme",
+  contentOverride: "layout.css.prefers-color-scheme.content-override",
+  density: "browser.uidensity",
+  multithread: "vantage.download.multithread",
+  sidebarHover: "vantage.sidebar.hover-autohide.enabled",
+  findbar: "vantage.findbar.topright",
+  tabsUnload: "browser.tabs.unloadOnLowMemory",
+  updateCheck: "vantage.updateCheck.enabled",
+  aiSidebar: "browser.ml.chat.enabled",
+  siteFixesBaseline: "privacy.trackingprotection.allow_list.baseline.enabled",
+  siteFixesConvenience:
+    "privacy.trackingprotection.allow_list.convenience.enabled",
+  doh: "network.trr.mode",
+  done: "vantage.onboarding.done",
+};
+
+const FEATURE_PREFS = {
+  multithread: PREF.multithread,
+  "sidebar-hover": PREF.sidebarHover,
+  findbar: PREF.findbar,
+  "tabs-unload": PREF.tabsUnload,
+  "update-check": PREF.updateCheck,
+  "ai-sidebar": PREF.aiSidebar,
+  "site-fixes": PREF.siteFixesBaseline,
+  doh: PREF.doh,
+};
+
+const DEFAULTS = {
+  [PREF.theme]: true,
+  [PREF.nova]: true,
+  [PREF.density]: 0,
+  [PREF.multithread]: false,
+  [PREF.sidebarHover]: false,
+  [PREF.findbar]: false,
+  [PREF.tabsUnload]: true,
+  [PREF.updateCheck]: true,
+  [PREF.aiSidebar]: false,
+  [PREF.siteFixesBaseline]: true,
+  [PREF.siteFixesConvenience]: true,
+  [PREF.doh]: 2,
+};
+
+function getBool(name) {
+  try {
+    return Services.prefs.getBoolPref(name);
+  } catch (e) {
+    return !!DEFAULTS[name];
+  }
+}
+
+function getInt(name) {
+  try {
+    return Services.prefs.getIntPref(name);
+  } catch (e) {
+    return Number(DEFAULTS[name] ?? 0);
+  }
+}
+
+function setBool(name, value) {
+  Services.prefs.setBoolPref(name, !!value);
+}
+
+function setInt(name, value) {
+  Services.prefs.setIntPref(name, Number(value));
+}
+
+const screens = Array.from(document.querySelectorAll(".screen[data-screen]"));
+const dotsWrap = document.getElementById("dots");
+const backBtn = document.getElementById("backBtn");
+const nextBtn = document.getElementById("nextBtn");
+const skipBtn = document.getElementById("skipBtn");
+const finishBtn = document.getElementById("finishBtn");
+const doneView = document.getElementById("doneView");
+const total = screens.length;
+
+let step = 0;
+let animating = false;
+let mode = "auto";
+
+// ---------- 步骤点 ----------
+for (let i = 1; i <= total; i++) {
+  const b = document.createElement("button");
+  b.type = "button";
+  b.dataset.go = String(i);
+  b.addEventListener("click", () => showStep(i));
+  dotsWrap.appendChild(b);
+}
+const dots = Array.from(dotsWrap.children);
+
+// ---------- 外观 ----------
+const themeSwitch = document.getElementById("themeSwitch");
+const variantSeg = document.getElementById("variantSeg");
+const modeSeg = document.getElementById("modeSeg");
+const densitySeg = document.getElementById("densitySeg");
+
+function applyTheme(value) {
+  document.documentElement.dataset.vantageTheme = value ? "on" : "off";
+}
+
+function applyDark() {
+  const dark =
+    mode === "dark" ||
+    (mode === "auto" &&
+      window.matchMedia("(prefers-color-scheme: dark)").matches);
+  document.documentElement.dataset.dark = dark ? "true" : "false";
+}
+
+function applyModeButtons() {
+  modeSeg.querySelectorAll("button").forEach(b => {
+    b.setAttribute("aria-pressed", String(b.dataset.mode === mode));
+  });
+}
+
+function applyVariant(value) {
+  variantSeg.querySelectorAll("button").forEach(b => {
+    b.setAttribute("aria-pressed", String(b.dataset.variant === value));
+  });
+}
+
+function applyDensity(value) {
+  densitySeg.querySelectorAll("button").forEach(b => {
+    b.setAttribute("aria-pressed", String(b.dataset.density === value));
+  });
+}
+
+const MODE_TO_PREF = { dark: 0, light: 1, auto: 2 };
+
+function readMode() {
+  const value = getInt(PREF.toolbarTheme);
+  return value === 0 ? "dark" : value === 1 ? "light" : "auto";
+}
+
+function writeMode(value) {
+  const n = MODE_TO_PREF[value] ?? 2;
+  setInt(PREF.toolbarTheme, n);
+  setInt(PREF.contentTheme, n);
+  setInt(PREF.contentOverride, n);
+}
+
+themeSwitch.checked = getBool(PREF.theme);
+applyTheme(themeSwitch.checked);
+themeSwitch.addEventListener("change", () => {
+  setBool(PREF.theme, themeSwitch.checked);
+  applyTheme(themeSwitch.checked);
+});
+
+const novaEnabled = getBool(PREF.nova);
+applyVariant(novaEnabled ? "nova" : "proton");
+variantSeg.addEventListener("click", event => {
+  const btn = event.target.closest("button[data-variant]");
+  if (!btn) {
+    return;
+  }
+  const isNova = btn.dataset.variant === "nova";
+  setBool(PREF.nova, isNova);
+  applyVariant(btn.dataset.variant);
+});
+
+mode = readMode();
+applyModeButtons();
+applyDark();
+modeSeg.addEventListener("click", event => {
+  const btn = event.target.closest("button[data-mode]");
+  if (!btn) {
+    return;
+  }
+  mode = btn.dataset.mode;
+  writeMode(mode);
+  applyModeButtons();
+  applyDark();
+});
+
+const densityValue = getInt(PREF.density);
+applyDensity(
+  densityValue === 1 ? "compact" : densityValue === 2 ? "touch" : "normal"
+);
+densitySeg.addEventListener("click", event => {
+  const btn = event.target.closest("button[data-density]");
+  if (!btn) {
+    return;
+  }
+  const value = { normal: 0, compact: 1, touch: 2 }[btn.dataset.density] ?? 0;
+  setInt(PREF.density, value);
+  applyDensity(btn.dataset.density);
+});
+
+// ---------- 功能开关 ----------
+document.querySelectorAll("[data-feature]").forEach(input => {
+  const key = input.dataset.feature;
+  if (key === "doh") {
+    input.checked = getInt(PREF.doh) !== 0;
+    input.addEventListener("change", () => {
+      setInt(PREF.doh, input.checked ? 2 : 0);
+    });
+    return;
+  }
+  if (key === "site-fixes") {
+    input.checked =
+      getBool(PREF.siteFixesBaseline) && getBool(PREF.siteFixesConvenience);
+    input.addEventListener("change", () => {
+      setBool(PREF.siteFixesBaseline, input.checked);
+      setBool(PREF.siteFixesConvenience, input.checked);
+    });
+    return;
+  }
+  const pref = FEATURE_PREFS[key];
+  if (!pref) {
+    return;
+  }
+  input.checked = getBool(pref);
+  input.addEventListener("change", () => setBool(pref, input.checked));
+});
+
+// ---------- 导入 / 默认 ----------
+function getBrowserWindow() {
+  return Services.wm.getMostRecentWindow("navigator:browser");
+}
+
+document.getElementById("importBtn").addEventListener("click", () => {
+  const win = getBrowserWindow();
+  const { MigrationUtils } = ChromeUtils.importESModule(
+    "resource:///modules/MigrationUtils.sys.mjs"
+  );
+  if (win) {
+    MigrationUtils.showMigrationWizard(win, { entrypoint: "newtab" });
+  }
+});
+
+// 外部链接统一用浏览器窗口打开，避免 chrome 页面里 target=_blank 变成空白页
+function openExternalLink(url) {
+  const win = getBrowserWindow();
+  if (win) {
+    win.openTrustedLinkIn(url, "tab");
+  } else {
+    window.open(url, "_blank");
+  }
+}
+
+document.querySelectorAll("a[href]").forEach(link => {
+  const href = link.getAttribute("href");
+  if (!/^(https?:|about:)/.test(href)) {
+    return;
+  }
+  link.addEventListener("click", event => {
+    event.preventDefault();
+    openExternalLink(href);
+  });
+});
+
+const defaultSwitch = document.getElementById("defaultSwitch");
+defaultSwitch.addEventListener("change", async () => {
+  if (!defaultSwitch.checked) {
+    return;
+  }
+  try {
+    const { ShellService } = ChromeUtils.importESModule(
+      "resource:///modules/ShellService.sys.mjs"
+    );
+    await ShellService.setDefaultBrowser();
+  } catch (e) {
+    defaultSwitch.checked = false;
+  }
+});
+
+// ---------- 完成 / 导航 ----------
+function finish() {
+  try {
+    Services.prefs.setBoolPref(PREF.done, true);
+  } catch (e) {
+    // 写失败不影响关闭
+  }
+  const win = getBrowserWindow();
+  if (win) {
+    win.gBrowser.removeCurrentTab();
+  }
+}
+
+function paint(n, push) {
+  step = n;
+  screens.forEach(s =>
+    s.classList.toggle("is-active", Number(s.dataset.screen) === n)
+  );
+  dots.forEach(d =>
+    d.setAttribute("aria-current", String(Number(d.dataset.go) === n))
+  );
+  backBtn.hidden = n === 1;
+  doneView.classList.remove("is-active");
+  nextBtn.hidden = n === total;
+  finishBtn.hidden = n !== total;
+  if (push !== false) {
+    const url = new URL(location.href);
+    url.searchParams.set("step", n);
+    history.replaceState(null, "", url);
+  }
+  const heading = screens[n - 1].querySelector("h1");
+  if (heading) {
+    heading.focus();
+  }
+}
+
+function showStep(n, push) {
+  n = Math.max(1, Math.min(total, n));
+  if (n === step || animating) {
+    return;
+  }
+  const current = step ? screens[step - 1] : null;
+  if (!current) {
+    paint(n, push);
+    return;
+  }
+  animating = true;
+  current.classList.add("is-leaving");
+  setTimeout(() => {
+    current.classList.remove("is-active", "is-leaving");
+    paint(n, push);
+    animating = false;
+  }, 170);
+}
+
+nextBtn.addEventListener("click", () => showStep(step + 1));
+finishBtn.addEventListener("click", finish);
+backBtn.addEventListener("click", () => showStep(step - 1));
+skipBtn.addEventListener("click", finish);
+
+document.getElementById("doneClose").addEventListener("click", finish);
+document.getElementById("doneNewTab").addEventListener("click", () => {
+  const win = getBrowserWindow();
+  if (win) {
+    win.openTrustedLinkIn("about:newtab", "tab");
+    win.gBrowser.removeCurrentTab();
+  }
+});
+
+document.addEventListener("keydown", event => {
+  if (event.altKey || event.metaKey || event.ctrlKey) {
+    return;
+  }
+  const t = event.target;
+  if (t && (t.tagName === "INPUT" || t.tagName === "BUTTON" || t.isContentEditable)) {
+    return;
+  }
+  if (event.key === "ArrowRight") {
+    showStep(step + 1);
+  } else if (event.key === "ArrowLeft") {
+    showStep(step - 1);
+  }
+});
+
+// 给开关补上可读标签（用同行的标题元素）
+document.querySelectorAll("input.switch").forEach((input, index) => {
+  const row = input.closest(".field, .option-row");
+  const title = row?.querySelector(".field-title, h3");
+  if (!title) {
+    return;
+  }
+  if (!title.id) {
+    title.id = `onboarding-label-${index}`;
+  }
+  input.setAttribute("aria-labelledby", title.id);
+});
+
+const mq = window.matchMedia("(prefers-color-scheme: dark)");
+mq.addEventListener?.("change", () => {
+  if (mode === "auto") {
+    applyDark();
+  }
+});
+
+const params = new URLSearchParams(location.search);
+showStep(Number(params.get("step")) || 1, false);
