+
+  <main class="stage">
+
+    <!-- 1 欢迎 -->
+    <section class="screen is-active" data-screen="1">
+      <div class="split">
+        <div>
+          <span class="eyebrow" data-l10n-id="onboarding-welcome-eyebrow"></span>
+          <h1 tabindex="-1" data-l10n-id="onboarding-welcome-title"></h1>
+          <p class="lead" data-l10n-id="onboarding-welcome-body"></p>
+          <ul class="bullets">
+            <li>
+              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
+              <span data-l10n-id="onboarding-welcome-point-esr"></span>
+            </li>
+            <li>
+              <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8.5l3.2 3.2L13 5" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
+              <span data-l10n-id="onboarding-welcome-point-privacy"></span>
+            </li>
