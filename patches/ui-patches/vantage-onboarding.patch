diff --git a/browser/base/content/onboarding/onboarding.css b/browser/base/content/onboarding/onboarding.css
new file mode 100644
index 0000000..30b69c9
--- /dev/null
+++ b/browser/base/content/onboarding/onboarding.css
@@ -0,0 +1,424 @@
+/* ===== Vantage 品牌色（取自 browser/themes/shared/vantage-theme.css） ===== */
+  :root {
+    --accent: #3b82f6;
+    --accent-hover: #2563eb;
+    --accent-active: #1d4ed8;
+    --accent-soft: #eef4ff;
+    --accent-soft-2: #dbeafe;
+    --teal: #0ea5a0;
+    --green: #10b981;
+    --brand-gradient: linear-gradient(90deg, #3b82f6 0%, #0ea5a0 52%, #10b981 100%);
+
+    --bg: #f8fafc;
+    --panel: #ffffff;
+    --panel-2: #f3f6fc;
+    --text: #1a2b3c;
+    --muted: #5a6b7c;
+    --faint: #8ba3c8;
+    --line: rgba(157, 180, 208, .42);
+    --line-strong: rgba(139, 163, 200, .62);
+    --ok: #10b981;
+    --shadow: 0 16px 44px rgba(26, 43, 60, .12);
+    --radius: 14px;
+  }
+
+  html[data-dark="true"] {
+    --accent: #60a5fa;
+    --accent-hover: #3b82f6;
+    --accent-active: #2563eb;
+    --accent-soft: #1b2b42;
+    --accent-soft-2: #223a5c;
+    --bg: #141316;
+    --panel: #1d1b1f;
+    --panel-2: #26232a;
+    --text: #ebf4f5;
+    --muted: #8fa8ae;
+    --faint: #6680a8;
+    --line: rgba(143, 168, 174, .26);
+    --line-strong: rgba(143, 168, 174, .44);
+    --ok: #34d399;
+    --shadow: 0 16px 44px rgba(0, 0, 0, .5);
+  }
+
+  /* 关闭 Vantage 主题：回到 Firefox 原生紫 */
+  html[data-vantage-theme="off"] {
+    --accent: #8b5cf6;
+    --accent-hover: #7c3aed;
+    --accent-active: #6d28d9;
+    --accent-soft: #f3edff;
+    --accent-soft-2: #e9dcff;
+    --brand-gradient: linear-gradient(90deg, #8b5cf6 0%, #a855f7 100%);
+  }
+  html[data-dark="true"][data-vantage-theme="off"] {
+    --accent: #a78bfa;
+    --accent-hover: #8b5cf6;
+    --accent-soft: #2a2340;
+    --accent-soft-2: #3a3058;
+  }
+
+  * { box-sizing: border-box; }
+  html, body { height: 100%; }
+
+  body {
+    margin: 0;
+    color: var(--text);
+    background: var(--bg);
+    font-family: system-ui, -apple-system, "Segoe UI", "PingFang SC", "Hiragino Sans GB",
+                 "Microsoft YaHei", "Noto Sans CJK SC", sans-serif;
+    -webkit-font-smoothing: antialiased;
+    display: flex;
+    align-items: center;
+    justify-content: center;
+    padding: 24px 18px;
+  }
+
+  button { font: inherit; color: inherit; }
+
+  .app {
+    width: min(1120px, 100%);
+    min-height: min(720px, calc(100vh - 48px));
+    background: var(--panel);
+    border: 1px solid var(--line);
+    border-radius: 16px;
+    box-shadow: var(--shadow);
+    display: flex;
+    flex-direction: column;
+    overflow: hidden;
+    position: relative;
+  }
+
+  /* Vantage 品牌渐变条 */
+  .app::before {
+    content: "";
+    position: absolute; inset: 0 0 auto 0; height: 3px;
+    background: var(--brand-gradient);
+    z-index: 20;
+  }
+
+  /* ---------- 顶栏 ---------- */
+  .topbar {
+    display: flex; align-items: center; gap: 10px;
+    padding: 19px 26px 17px;
+    border-bottom: 1px solid var(--line);
+  }
+  .brand { display: flex; align-items: center; gap: 9px; font-weight: 650; letter-spacing: .1px; }
+  .brand img { width: 24px; height: 24px; border-radius: 6px; }
+  .brand small { color: var(--faint); font-weight: 500; letter-spacing: 0; font-size: 12px; }
+  .topbar .spacer { flex: 1; }
+  .link-btn {
+    border: 0; background: transparent; color: var(--muted);
+    padding: 7px 11px; border-radius: 8px; cursor: pointer; font-size: 13px;
+  }
+  .link-btn:hover { background: var(--panel-2); color: var(--text); }
+
+  /* ---------- 主体 ---------- */
+  .stage { flex: 1; position: relative; min-height: 0; }
+  .screen {
+    position: absolute; inset: 0;
+    padding: 34px 44px 30px;
+    display: none;
+    overflow: auto;
+  }
+  .screen.is-active {
+    display: block;
+    animation: screenIn .26s ease both;
+  }
+  .screen.is-leaving {
+    display: block; pointer-events: none;
+    animation: screenOut .17s ease both;
+  }
+  @keyframes screenIn {
+    from { opacity: 0; transform: translateY(8px); }
+    to { opacity: 1; transform: none; }
+  }
+  @keyframes screenOut {
+    from { opacity: 1; transform: none; }
+    to { opacity: 0; transform: translateY(-6px); }
+  }
+  @media (prefers-reduced-motion: reduce) {
+    .screen.is-active, .screen.is-leaving { animation: none; }
+    * { transition: none !important; }
+  }
+
+  .split {
+    display: grid;
+    grid-template-columns: minmax(0, 1fr) minmax(330px, .9fr);
+    gap: 42px;
+    align-items: center;
+    min-height: 100%;
+  }
+  .split.single {
+    grid-template-columns: minmax(0, 1fr);
+    max-width: 680px;
+    align-content: start;
+    padding-top: 6px;
+  }
+
+  .eyebrow {
+    display: inline-flex; align-items: center; gap: 7px;
+    font-size: 12px; font-weight: 650; letter-spacing: .3px;
+    color: var(--accent);
+    background: var(--accent-soft);
+    border: 1px solid color-mix(in srgb, var(--accent) 18%, transparent);
+    border-radius: 999px; padding: 5px 11px;
+    margin-bottom: 16px;
+  }
+  .eyebrow::before {
+    content: ""; width: 6px; height: 6px; border-radius: 50%;
+    background: var(--brand-gradient);
+  }
+
+  h1 {
+    font-size: clamp(27px, 3.1vw, 36px);
+    line-height: 1.2; letter-spacing: -.5px;
+    margin: 0 0 14px; outline: none;
+  }
+  .lead {
+    font-size: 15.5px; line-height: 1.72; color: var(--muted);
+    margin: 0 0 20px; max-width: 48ch;
+  }
+
+  .bullets { list-style: none; margin: 0; padding: 0; display: grid; gap: 11px; }
+  .bullets li {
+    display: flex; gap: 10px; align-items: flex-start;
+    font-size: 14px; color: var(--muted); line-height: 1.55;
+  }
+  .bullets svg { flex: none; margin-top: 2px; color: var(--accent); }
+
+  .hero-visual {
+    display: flex; align-items: center; justify-content: center;
+    min-height: 320px; position: relative;
+  }
+  .hero-logo {
+    width: 172px; height: 172px; border-radius: 38px;
+    box-shadow: 0 20px 50px rgba(26, 43, 60, .20);
+  }
+
+  /* ---------- 主题商店引导 ---------- */
+  .store-cta {
+    display: flex; align-items: center; gap: 12px; margin-top: 14px;
+    padding: 12px 14px; border: 1px solid color-mix(in srgb, var(--accent) 26%, var(--line));
+    border-radius: 10px; background: var(--accent-soft);
+  }
+  .store-cta .grow { flex: 1; min-width: 0; }
+  .store-cta strong { display: block; font-size: 13px; margin-bottom: 2px; }
+  .store-cta span { color: var(--muted); font-size: 12px; line-height: 1.5; }
+
+  /* ---------- 表单行 ---------- */
+  .field { padding: 12px 0; border-bottom: 1px solid var(--line); }
+  .field:last-of-type { border-bottom: 0; }
+  .field-head { display: flex; align-items: center; gap: 12px; }
+  .field-title { font-size: 14px; font-weight: 620; }
+  .field-desc { color: var(--muted); font-size: 12.5px; line-height: 1.5; margin-top: 2px; }
+  .field .grow { flex: 1; min-width: 0; }
+
+  .switch {
+    appearance: none; width: 40px; height: 23px; border-radius: 999px;
+    background: var(--line-strong); position: relative; cursor: pointer;
+    transition: background .16s ease; flex: none;
+  }
+  .switch::after {
+    content: ""; position: absolute; top: 3px; left: 3px;
+    width: 17px; height: 17px; border-radius: 50%; background: #fff;
+    box-shadow: 0 1px 3px rgba(0, 0, 0, .25); transition: transform .16s ease;
+  }
+  .switch:checked { background: var(--accent); }
+  .switch:checked::after { transform: translateX(17px); }
+  .switch:focus-visible { outline: 2px solid var(--accent); outline-offset: 3px; }
+
+  .segmented {
+    display: inline-flex; background: var(--panel-2); border: 1px solid var(--line);
+    border-radius: 9px; padding: 3px; gap: 2px; flex: none;
+  }
+  .segmented button {
+    border: 0; background: transparent; color: var(--muted);
+    padding: 6px 12px; border-radius: 6px; cursor: pointer; font-size: 12.5px;
+  }
+  .segmented button[aria-pressed="true"] {
+    background: var(--panel); color: var(--text);
+    box-shadow: 0 1px 3px rgba(26, 43, 60, .14); font-weight: 600;
+  }
+  .segmented button:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+
+  /* ---------- 隐私卡片 ---------- */
+  .privacy-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; margin-top: 4px; }
+  .choice {
+    position: relative; text-align: left; cursor: pointer;
+    background: var(--panel); border: 1.5px solid var(--line);
+    border-radius: 12px; padding: 16px 15px 14px;
+    display: flex; flex-direction: column; gap: 7px;
+    transition: border-color .15s ease, background .15s ease;
+  }
+  .choice:hover { border-color: var(--line-strong); }
+  .choice[aria-checked="true"] {
+    border-color: var(--accent); background: var(--accent-soft);
+    box-shadow: 0 0 0 2px color-mix(in srgb, var(--accent) 14%, transparent);
+  }
+  .choice:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+  .choice .icon {
+    width: 32px; height: 32px; border-radius: 8px;
+    display: grid; place-items: center; background: var(--accent-soft-2); color: var(--accent);
+  }
+  .choice h3 { margin: 1px 0 0; font-size: 14.5px; }
+  .choice p { margin: 0; color: var(--muted); font-size: 12.3px; line-height: 1.55; }
+  .badge {
+    position: absolute; top: 11px; right: 11px;
+    font-size: 10px; font-weight: 650; color: var(--accent);
+    background: var(--panel); border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--line));
+    border-radius: 999px; padding: 2px 7px;
+  }
+  .checkmark {
+    position: absolute; top: 11px; right: 11px; width: 17px; height: 17px;
+    border-radius: 50%; background: var(--accent); color: #fff; display: none; place-items: center;
+  }
+  .choice[aria-checked="true"] .checkmark { display: grid; }
+  .choice[aria-checked="true"] .badge { display: none; }
+
+  /* ---------- 功能开关列表 ---------- */
+  .feature-list { display: grid; gap: 0; margin-top: 2px; }
+  .feature-list .field { padding: 11px 0; }
+
+  .note {
+    display: flex; gap: 9px; align-items: flex-start;
+    margin-top: 16px; padding: 11px 13px;
+    background: var(--panel-2); border: 1px solid var(--line);
+    border-radius: 10px; color: var(--muted); font-size: 12.3px; line-height: 1.6;
+  }
+  .note svg { flex: none; margin-top: 1px; color: var(--accent); }
+  .note a { color: var(--accent); text-decoration: none; }
+  .note a:hover { text-decoration: underline; }
+
+  /* ---------- 扩展 ---------- */
+  .ext-card {
+    display: flex; align-items: center; gap: 14px;
+    padding: 14px 16px; border: 1px solid var(--line); border-radius: 12px;
+    background: var(--panel); margin-bottom: 10px;
+  }
+  .ext-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
+  .ext-grid .ext-card { margin-bottom: 0; }
+  .tag.soft {
+    color: var(--muted); background: var(--panel-2);
+    border: 1px solid var(--line);
+  }
+  .ext-card .logo {
+    width: 40px; height: 40px; border-radius: 10px; flex: none;
+    display: grid; place-items: center;
+    background: var(--accent-soft-2); color: var(--accent); font-weight: 700; font-size: 13px;
+  }
+  .ext-card h3 { margin: 0 0 2px; font-size: 14px; }
+  .ext-card p { margin: 0; color: var(--muted); font-size: 12.3px; line-height: 1.55; }
+  .ext-card .grow { flex: 1; min-width: 0; }
+  .tag {
+    font-size: 10px; font-weight: 650; color: var(--accent);
+    background: var(--accent-soft); border-radius: 999px; padding: 2px 7px; margin-left: 6px;
+  }
+
+  /* ---------- 导入 ---------- */
+  .option-row {
+    display: flex; align-items: center; gap: 14px;
+    padding: 15px 16px; border: 1px solid var(--line);
+    border-radius: 12px; background: var(--panel); margin-bottom: 10px;
+  }
+  .option-row .icon {
+    width: 38px; height: 38px; border-radius: 9px; flex: none;
+    display: grid; place-items: center; background: var(--accent-soft-2); color: var(--accent);
+  }
+  .option-row .grow { flex: 1; min-width: 0; }
+  .option-row h3 { margin: 0 0 2px; font-size: 14px; }
+  .option-row p { margin: 0; color: var(--muted); font-size: 12.3px; line-height: 1.5; }
+
+  /* ---------- 按钮 ---------- */
+  .btn {
+    border: 1px solid var(--line-strong); background: var(--panel);
+    border-radius: 8px; padding: 8px 14px; cursor: pointer;
+    font-size: 12.8px; font-weight: 560; white-space: nowrap;
+  }
+  .btn:hover { background: var(--panel-2); }
+  .btn.primary {
+    background: var(--accent); border-color: var(--accent); color: #fff;
+    box-shadow: 0 6px 16px color-mix(in srgb, var(--accent) 28%, transparent);
+    transition: background .16s ease, box-shadow .16s ease;
+  }
+  .btn.primary:hover {
+    background: var(--accent-hover); border-color: var(--accent-hover);
+    box-shadow: 0 8px 20px color-mix(in srgb, var(--accent) 34%, transparent);
+  }
+  .btn.ghost { background: transparent; border-color: transparent; color: var(--muted); }
+  .btn.ghost:hover { background: var(--panel-2); color: var(--text); }
+  .btn:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
+
+  /* ---------- 底部 ---------- */
+  .footer {
+    display: flex; align-items: center; gap: 16px;
+    padding: 16px 24px; border-top: 1px solid var(--line); background: var(--panel);
+  }
+  .dots { display: flex; gap: 6px; flex: 1; align-items: center; }
+  .dots button {
+    width: 7px; height: 7px; border-radius: 50%; border: 0; padding: 0;
+    background: var(--line-strong); cursor: pointer;
+    transition: width .18s ease, background .18s ease;
+  }
+  .dots button[aria-current="true"] { width: 22px; border-radius: 999px; background: var(--accent); }
+  .footer .nav { display: flex; gap: 9px; }
+
+  /* ---------- 完成态 ---------- */
+  .done {
+    position: absolute; inset: 0; display: none; place-items: center; text-align: center;
+    padding: 40px; background: var(--panel); z-index: 5;
+  }
+  .done.is-active { display: grid; animation: screenIn .24s ease both; }
+  .done .icon {
+    width: 68px; height: 68px; border-radius: 50%;
+    background: color-mix(in srgb, var(--ok) 14%, transparent); color: var(--ok);
+    display: grid; place-items: center; margin: 0 auto 16px;
+    animation: popIn .4s cubic-bezier(.2, .9, .3, 1.2) both;
+  }
+  @keyframes popIn {
+    from { opacity: 0; transform: scale(.6); }
+    to { opacity: 1; transform: scale(1); }
+  }
+  .done h2 { font-size: 24px; margin: 0 0 8px; }
+  .done p { color: var(--muted); margin: 0 0 22px; line-height: 1.65; }
+  .done .nav { display: flex; gap: 9px; justify-content: center; }
+
+  /* ---------- 弹窗 ---------- */
+  .modal-backdrop {
+    position: absolute; inset: 0; background: rgba(14, 22, 32, .45);
+    display: none; align-items: center; justify-content: center; z-index: 10; padding: 24px;
+  }
+  .modal-backdrop.is-open { display: flex; }
+  .modal {
+    width: min(430px, 100%); background: var(--panel);
+    border: 1px solid var(--line); border-radius: 14px;
+    box-shadow: var(--shadow); padding: 20px;
+  }
+  .modal h3 { margin: 0 0 3px; font-size: 16px; }
+  .modal .sub { color: var(--muted); font-size: 12.3px; margin: 0 0 15px; }
+  .browser-list { display: grid; gap: 7px; margin-bottom: 16px; }
+  .browser-item {
+    display: flex; align-items: center; gap: 10px;
+    padding: 10px 11px; border: 1px solid var(--line);
+    border-radius: 9px; cursor: pointer; background: var(--panel);
+    font-size: 12.8px;
+  }
+  .browser-item[aria-checked="true"] { border-color: var(--accent); background: var(--accent-soft); }
+  .browser-item:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
+  .browser-item .glyph {
+    width: 21px; height: 21px; border-radius: 5px; background: var(--panel-2);
+    display: grid; place-items: center; font-size: 10px; font-weight: 700; color: var(--muted);
+  }
+  .browser-item .grow { flex: 1; }
+  .modal .nav { display: flex; justify-content: flex-end; gap: 9px; }
+  .progress { height: 5px; border-radius: 999px; background: var(--panel-2); overflow: hidden; margin: 2px 0 16px; display: none; }
+  .progress.is-on { display: block; }
+  .progress i { display: block; height: 100%; width: 0; background: var(--brand-gradient); transition: width .4s ease; }
+
+  @media (max-width: 900px) {
+    .screen { position: relative; inset: auto; padding: 26px 22px; }
+    .app { min-height: 0; }
+    .split { grid-template-columns: 1fr; gap: 24px; align-items: start; }
+    .privacy-grid { grid-template-columns: 1fr; }
+    .hero-visual { min-height: 220px; }
+    .hero-visual .plate { width: 220px; height: 220px; }
+    .hero-visual img { width: 100px; height: 100px; }
+  }
