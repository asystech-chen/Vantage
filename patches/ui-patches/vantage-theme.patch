+:root:not([vantage-sidebar-revamp])[vantage-sidebar-floating] #browser > #sidebar-splitter,
+:root:not([vantage-sidebar-revamp])[vantage-sidebar-floating] #browser > #sidebar-launcher-splitter {
+  width: 0 !important;
+  min-width: 0 !important;
+  max-width: 0 !important;
+  margin: 0 !important;
+  padding: 0 !important;
+  border: 0 !important;
+  overflow: hidden !important;
+}
+:root:not([vantage-sidebar-revamp])[vantage-sidebar-floating] #browser > #sidebar-box {
+  position: absolute !important;
