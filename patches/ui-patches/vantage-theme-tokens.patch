diff --git a/toolkit/themes/shared/design-system/vantage-tokens.css b/toolkit/themes/shared/design-system/vantage-tokens.css
new file mode 100644
index 0000000..3b2dce8
--- /dev/null
+++ b/toolkit/themes/shared/design-system/vantage-tokens.css
@@ -0,0 +1,75 @@
+/* This Source Code Form is subject to the terms of the Mozilla Public
+ * License, v. 2.0. If a copy of the MPL was not distributed with this
+ * file, You can obtain one at http://mozilla.org/MPL/2.0/. */
+
+/* ===== Vantage 主题：全局设计令牌 =====
+   由 vantage.theme.enabled 开关控制，并在第三方主题激活时让位。
+   放在 toolkit/global 样式层，让主窗口之外的 chrome 文档（侧栏、设置、
+   书库、页面信息、对话框等）也拿到同一套 Vantage 强调色。 */
+
+@media -moz-pref("vantage.theme.enabled") {
+  :root:not([lwtheme]) {
+    /* Vantage 品牌基础色（原 vantage-nova-colors.patch 效果） */
+    --color-gray-0: #f8fafc !important;
+    --color-violet-0: #eef4ff !important;
+    --color-violet-10: #dbeafe !important;
+    --color-violet-20: #93c5fd !important;
+    --color-violet-30: #60a5fa !important;
+    --color-violet-40: #3b82f6 !important;
+    --color-violet-50: #3b82f6 !important;
+    --color-violet-60: #2563eb !important;
+    --color-violet-70: #1d4ed8 !important;
+    --color-violet-80: #1e3a8a !important;
+    --color-violet-90: #172554 !important;
+    --color-violet-100: #0f1e40 !important;
+    --color-violet-110: #0a1428 !important;
+    --color-violet-desaturated-0: #f3f6fc !important;
+    --color-violet-desaturated-10: #e5edf9 !important;
+    --color-violet-desaturated-20: #cfdcf0 !important;
+    --color-violet-desaturated-30: #aec2de !important;
+    --color-violet-desaturated-40: #8ba3c8 !important;
+    --color-violet-desaturated-50: #6680a8 !important;
+    --color-violet-desaturated-60: #4d628a !important;
+    --color-violet-desaturated-70: #37486b !important;
+    --color-violet-desaturated-80: #232f4d !important;
+    --color-violet-desaturated-90: #151d33 !important;
+
+    /* 强调色：Vantage 偏蓝 */
+    --color-accent-primary: #3b82f6 !important;
+    --color-accent-primary-hover: #2563eb !important;
+    --color-accent-primary-active: #1d4ed8 !important;
+    --color-accent-primary-selected: #3b82f6 !important;
+    --button-primary-bgcolor: #3b82f6 !important;
+    --button-primary-hover-bgcolor: #2563eb !important;
+    --button-primary-active-bgcolor: #1d4ed8 !important;
+    --focus-outline-color: #3b82f6 !important;
+
+    --toolbarbutton-background-color-hover: light-dark(color-mix(in srgb, #3b82f6 25%, transparent), color-mix(in srgb, #60a5fa 25%, transparent)) !important;
+    --toolbarbutton-background-color-active: light-dark(color-mix(in srgb, #3b82f6 40%, transparent), color-mix(in srgb, #60a5fa 40%, transparent)) !important;
+    --toolbarbutton-icon-fill: light-dark(#6680a8, #e5edf9) !important;
+    --link-color: light-dark(#3b82f6, #60a5fa) !important;
+  }
+
+  /* Nova 独有：attention 色（Proton 不覆盖，保持默认） */
+  @media -moz-pref("browser.nova.enabled") {
+    :root:not([lwtheme]) {
+      --color-accent-attention: #3b82f6 !important;
+      --toolbarbutton-icon-fill-attention: #3b82f6 !important;
+    }
+
+    @media (prefers-color-scheme: dark) {
+      :root:not([lwtheme]) {
+        --color-accent-primary: #60a5fa !important;
+        --color-accent-primary-hover: #3b82f6 !important;
+        --color-accent-primary-active: #2563eb !important;
+        --color-accent-primary-selected: #60a5fa !important;
+        --color-accent-attention: #60a5fa !important;
+        --button-primary-bgcolor: #60a5fa !important;
+        --button-primary-hover-bgcolor: #3b82f6 !important;
+        --button-primary-active-bgcolor: #2563eb !important;
+        --focus-outline-color: #60a5fa !important;
+        --toolbarbutton-icon-fill-attention: #60a5fa !important;
+      }
+    }
+  }
+}
