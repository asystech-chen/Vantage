diff --git a/browser/components/customizableui/CustomizableWidgets.sys.mjs b/browser/components/customizableui/CustomizableWidgets.sys.mjs
index c0dd6ce..8a0789c 100644
--- a/browser/components/customizableui/CustomizableWidgets.sys.mjs
+++ b/browser/components/customizableui/CustomizableWidgets.sys.mjs
@@ -326,6 +326,47 @@ export const CustomizableWidgets = [
       }
     },
   },
+  {
+    // Vantage: "Workspaces" entry point. Left-click opens a small menu with
+    // the two building blocks: profiles (identity isolation) and tab groups
+    // (project spaces inside one profile).
+    id: "vantage-workspace-button",
+    l10nId: "vantage-workspace-button",
+    defaultArea: "nav-bar",
+    introducedInVersion: "pref",
+    onCreated(aNode) {
+      let doc = aNode.ownerDocument;
+      if (aNode.querySelector("menupopup")) {
+        return;
+      }
+      aNode.setAttribute("type", "menu");
+
+      let popup = doc.createXULElement("menupopup");
+      popup.id = "vantage-workspace-menu";
+
+      let addItem = (key, l10nId, handler) => {
+        let item = doc.createXULElement("menuitem");
+        item.id = "vantage-workspace-" + key;
+        doc.l10n.setAttributes(item, l10nId);
+        item.addEventListener("command", handler);
+        popup.appendChild(item);
+      };
+
+      let win = doc.defaultView;
+      addItem("profiles", "vantage-workspace-menu-profiles", () => {
+        win.openTrustedLinkIn("about:profilemanager", "tab");
+      });
+      addItem("new-profile", "vantage-workspace-menu-new-profile", () => {
+        win.openTrustedLinkIn("about:newprofile", "tab");
+      });
+      popup.appendChild(doc.createXULElement("menuseparator"));
+      addItem("tab-groups", "vantage-workspace-menu-tab-groups", () => {
+        win.PanelUI.showSubView("toolbar-tabGroupsListView", aNode);
+      });
+
+      aNode.appendChild(popup);
+    },
+  },
   {
     id: "print-button",
     l10nId: "navbar-print",
