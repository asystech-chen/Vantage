diff --git a/browser/components/customizableui/CustomizableWidgets.sys.mjs b/browser/components/customizableui/CustomizableWidgets.sys.mjs
index c0dd6ce..1931395 100644
--- a/browser/components/customizableui/CustomizableWidgets.sys.mjs
+++ b/browser/components/customizableui/CustomizableWidgets.sys.mjs
@@ -326,6 +326,95 @@ export const CustomizableWidgets = [
       }
     },
   },
+  {
+    // Vantage: "Workspaces" entry point. Left-click opens a small menu with
+    // the two building blocks: profiles (identity isolation) and tab groups
+    // (project spaces inside one profile).
+    id: "vantage-workspace-button",
+    l10nId: "vantage-workspace-button",
+    defaultArea: "nav-bar",
+    introducedInVersion: "pref",
+    onCreated(aNode) {
+      let doc = aNode.ownerDocument;
+      if (aNode.querySelector("menupopup")) {
+        return;
+      }
+      aNode.setAttribute("type", "menu");
+
+      let win = doc.defaultView;
+      let popup = doc.createXULElement("menupopup");
+      popup.id = "vantage-workspace-menu";
+
+      let addItem = (id, l10nId, handler) => {
+        let item = doc.createXULElement("menuitem");
+        item.id = "vantage-workspace-" + id;
+        doc.l10n.setAttributes(item, l10nId);
+        if (handler) {
+          item.addEventListener("command", handler);
+        }
+        popup.appendChild(item);
+        return item;
+      };
+      let addSeparator = () =>
+        popup.appendChild(doc.createXULElement("menuseparator"));
+
+      // Rebuilt every time the menu opens so it reflects the current groups.
+      let buildMenu = () => {
+        while (popup.firstChild) {
+          popup.firstChild.remove();
+        }
+
+        addItem("profiles", "vantage-workspace-menu-profiles", () => {
+          win.openTrustedLinkIn("about:profilemanager", "tab");
+        });
+        addItem("new-profile", "vantage-workspace-menu-new-profile", () => {
+          win.openTrustedLinkIn("about:newprofile", "tab");
+        });
+        addSeparator();
+
+        // One entry per tab group; clicking it focuses that group: every other
+        // group is collapsed, the target group is expanded and its first tab
+        // is selected (native TabGroup.select()).
+        let groups = Array.from(win.gBrowser.tabGroups).filter(
+          group => group.tabs.length
+        );
+        if (groups.length) {
+          for (let [index, group] of groups.entries()) {
+            let name = group.label || group.defaultGroupName;
+            let item = doc.createXULElement("menuitem");
+            item.id = "vantage-workspace-group-" + index;
+            item.setAttribute("label", `${name} (${group.tabs.length})`);
+            item.setAttribute("type", "radio");
+            item.setAttribute("name", "vantage-workspace-group");
+            item.toggleAttribute("checked", group.hasActiveTab);
+            item.addEventListener("command", () => {
+              for (let other of win.gBrowser.tabGroups) {
+                other.collapsed = other !== group;
+              }
+              group.select();
+            });
+            popup.appendChild(item);
+          }
+        } else {
+          let empty = doc.createXULElement("menuitem");
+          empty.setAttribute("disabled", "true");
+          doc.l10n.setAttributes(empty, "vantage-workspace-groups-empty");
+          popup.appendChild(empty);
+        }
+
+        addSeparator();
+        addItem("manage-groups", "vantage-workspace-manage-groups", () => {
+          // Let the menu close before anchoring the native panel to the button.
+          win.setTimeout(() => {
+            win.PanelUI.showSubView("toolbar-tabGroupsListView", aNode);
+          }, 0);
+        });
+      };
+
+      popup.addEventListener("popupshowing", buildMenu);
+      aNode.appendChild(popup);
+    },
+  },
   {
     id: "print-button",
     l10nId: "navbar-print",
