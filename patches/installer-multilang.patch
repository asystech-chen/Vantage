+    "zh-TW": ("TradChinese", "1028"),
+}
+
+
+def preprocess_multilocale_files(config_dir, locale_dirs):
+    """
+    Preprocesses installer locale properties files for multiple languages
+    (en-US / zh-CN / zh-TW) into the format required by NSIS.  Each language
+    gets its own nlf/nsh pair (with the real NSIS language ID), and the
+    override/custom LangString files are merged with per-language IDs so the
+    installer can auto-select the OS UI language at runtime.
+
+    Parameters:
+    config_dir   - the path to the destination directory
+    locale_dirs  - dict mapping locale code to a list of lookup directories
+    """
+    for code, (nsis_name, lang_id) in LANG_TABLE.items():
+        dirs = locale_dirs.get(code, locale_dirs.get("en-US", []))
+
+        # Per-language nlf (real NSIS language ID; all our locales are LTR)
+        fp = open_utf16le_file(join(config_dir, nsis_name + ".nlf"))
+        fp.write(
+            (
+                """# Header, don't edit
+NLF v6
+# Start editing here
+# Language ID
+%s
+# Font and size - dash (-) means default
+-
+-
+# Codepage - dash (-) means ANSI code page
+-
+# RTL - anything else than RTL means LTR
+-
+"""
+                % lang_id
+            ).encode("utf-16-le")
+        )
+        fp.close()
+
+        # Per-language MUI language file
+        fp = open_utf16le_file(join(config_dir, nsis_name + ".nsh"))
+        fp.write(
+            (
+                """;NSIS Modern User Interface - Language File
+;Compatible with Modern UI 1.68
+;Language: %s (%s)
+!insertmacro MOZ_MUI_LANGUAGEFILE_BEGIN \"%s\"
+!define MUI_LANGNAME \"%s\"
+"""
+                % (nsis_name, lang_id, nsis_name, nsis_name)
+            ).encode("utf-16-le")
+        )
+        locale_strings = get_locale_strings(
+            lookup("mui.properties", dirs), "!define ", " ", True
+        )
+        fp.write(locale_strings.encode("utf-16-le"))
+        fp.write("!insertmacro MOZ_MUI_LANGUAGEFILE_END\n".encode("utf-16-le"))
+        fp.close()
+
+    # Merged override strings (LangString ^name <id>)
+    fp = open_utf16le_file(join(config_dir, "overrideLocale.nsh"))
+    for code, (nsis_name, lang_id) in LANG_TABLE.items():
+        dirs = locale_dirs.get(code, locale_dirs.get("en-US", []))
+        fp.write(
+            get_locale_strings(
+                lookup("override.properties", dirs),
+                "LangString ^", " %s " % lang_id, False,
+            ).encode("utf-16-le")
+        )
+    fp.close()
+
+    # Merged custom strings (LangString name <id>)
+    fp = open_utf16le_file(join(config_dir, "customLocale.nsh"))
+    for code, (nsis_name, lang_id) in LANG_TABLE.items():
+        dirs = locale_dirs.get(code, locale_dirs.get("en-US", []))
+        fp.write(
+            get_locale_strings(
+                lookup("custom.properties", dirs),
+                "LangString ", " %s " % lang_id, True,
+            ).encode("utf-16-le")
+        )
+    fp.close()
