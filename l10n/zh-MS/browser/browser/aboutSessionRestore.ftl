restore-page-tab-title = 回复会话

# The title is intended to be apologetic and disarming, expressing dismay
# and regret that we are unable to restore the session for the user
restore-page-error-title = 难过的. 我们是财产烦恼采煤你的页回.
restore-page-problem-desc = 我们是财产烦恼恢复的你的最后浏览会话. 选择回复会话到试再一次.
restore-page-try-this = 仍然不能干的到回复你的会话? 以前的一个标签页是成为…的原因那发行. 查看早先的标签页, 移除那选择目录从那标签页你不要需要到恢复, 和然后回复.

restore-page-hide-tabs = 隐藏早先的标签页
restore-page-show-tabs = 查看早先的标签页

# When tabs are distributed across multiple windows, this message is used as a
# header above the group of tabs for each window.
#
# Variables:
#    $windowNumber: Progressive number associated to each window
restore-page-window-label = 窗口 { $windowNumber }

restore-page-restore-header =
    .label = 回复

restore-page-list-header =
    .label = 窗和标签页

restore-page-try-again-button =
    .label = 回复会话
    .accesskey = R

restore-page-close-button =
    .label = 启动新的会话
    .accesskey = N

## The following strings are used in about:welcomeback

welcome-back-tab-title = 成功!
welcome-back-page-title = 成功!
welcome-back-page-info = { -brand-short-name } 是预备好的状态到去.

welcome-back-restore-button =
    .label = 让我们去!
    .accesskey = L

welcome-back-restore-all-label = 回复所有的窗 & 标签页
welcome-back-restore-some-label = 回复仅那一(个) 你想要

welcome-back-page-info-link = 你的添加-ons 和定制有是离开的和你的浏览器设置有是精力充沛的到他们的默认. 如果这没有修复你的发行, <a data-l10n-name="link-more">学习更多关于什么你能做.</a>
