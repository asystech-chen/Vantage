webpage-languages-window2 =
    .title = 网页语言设置
    .style = min-width: 40媒体用毕符

languages-close-key =
    .key = w

languages-description = 网页是有时提供在更多比一(个) 语言. 选取语系为了展出这些网页, 在顺序的首选项

languages-customize-spoof-english =
    .label = 请求英语版本的网页为了增大的隐私

languages-customize-moveup =
    .label = 移动向上的
    .accesskey = U

languages-customize-movedown =
    .label = 移动向下
    .accesskey = D

languages-customize-remove =
    .label = 移除
    .accesskey = R

languages-customize-select-language =
    .placeholder = 选择一个语言到添加…

languages-customize-add =
    .label = 添加
    .accesskey = A

# The pattern used to generate strings presented to the user in the
# locale selection list.
#
# Example:
#   Icelandic [is]
#   Spanish (Chile) [es-CL]
#
# Variables:
#   $locale (String) - A name of the locale (for example: "Icelandic", "Spanish (Chile)")
#   $code (String) - Locale code of the locale (for example: "is", "es-CL")
languages-code-format =
    .label = { $locale } [{ $code }]

languages-active-code-format =
    .value = { languages-code-format.label }

browser-languages-window2 =
    .title = { -brand-short-name } 语言设置
    .style = min-width: 40媒体用毕符

browser-languages-description = { -brand-short-name } 将显示器那开始语言作为你的默认和将显示器交替的语系如果必要的在那顺序他们出现.

browser-languages-search = 搜索为了更多语系…

browser-languages-searching =
    .label = 搜索的为了语系…

browser-languages-downloading =
    .label = 下装…

browser-languages-select-language =
    .label = 选择一个语言到添加…
    .placeholder = 选择一个语言到添加…

browser-languages-installed-label = 安装语系
browser-languages-available-label = 可利用的语系

browser-languages-error = { -brand-short-name } 不能更新你的语系右现在. 复选那你是连接的到那因特网或尝试再一次.
