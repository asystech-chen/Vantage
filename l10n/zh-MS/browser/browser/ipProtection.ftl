# Variables
#   $usageLeft (number) - The amount of data a user has left in a month (in MB)
ip-protection-bandwidth-warning-infobar-message-90-mb = <strong>你是几乎外面的的 VPN 论据.</strong> 你有 { $usageLeft } MB 许可. 一次你使用它所有的, 你的 VPN 将暂停直到你的论据重置在那开始的近邻干扰月.

