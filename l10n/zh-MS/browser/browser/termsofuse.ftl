## Existing User Terms of Use InfoBar

#  Full infobar message, with inline links to the Terms of Use and Privacy Notice that will be added at runtime.
existing-user-tou-message = <strong>更新</strong> 我们已为您引入 { -brand-short-name } 的<a data-l10n-name="terms-of-use-link">使用条款</a>，并更新了<a data-l10n-name="privacy-notice-link">隐私声明</a>。恳请您抽出宝贵时间审阅并接受。

# Infobar message for when the Privacy Notice is updated.
existing-user-privacy-notice-update-message = 我们已更新<a data-l10n-name="privacy-notice-link">隐私声明</a>，以反映 { -brand-short-name } 中的最新功能。

# Text for secondary button linking to FAQ page
existing-user-tou-learn-more = 了解更多

# Text for primary button
existing-user-tou-accept = 接受

## Existing User Terms of Use Spotlight

# Full Spotlight body message, with inline links to the Terms of Use, Privacy Notice, and Learn More FAQ that will be added at runtime.
tou-existing-user-spotlight-body = 我们已引入<a data-l10n-name="terms-of-use">使用条款</a>并更新了<a data-l10n-name="privacy-notice">隐私声明</a>。<br><br> 恳请您抽出宝贵时间审阅并接受。 <a data-l10n-name="learn-more">了解更多</a>。

tou-existing-user-spotlight-remind-me-later = 稍后提醒我
