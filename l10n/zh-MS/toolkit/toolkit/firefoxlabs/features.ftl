experimental-features-custom-wallpaper =
    .label = 选取一个定制壁纸或颜色为了新的 Tab
experimental-features-custom-wallpaper-description = 上装你的自己的壁纸或拾取一个定制颜色为了你的新的 Tab 背景.

experimental-features-link-previews =
    .label = 连接预览
experimental-features-link-previews-description =
    { PLATFORM() ->
        [macos] 到学习更多关于一个网页在...之前你单击, 盘旋结束一个连接和压 Shift (⇧) 正差 Option (⌥) 或 Alt. 预览能包含详细数据相似的标题和阅读时间. 为了一些网页, AI 能也读取那页电文和产生键点. 那 AI 是最佳化的到读取和产生英语电文. 到按优先次序列出你的隐私, 那 AI 运行地方性地在你的计算机. <a data-l10n-name="connect">部分反馈</a>
       *[other] 到学习更多关于一个网页在...之前你单击, 盘旋结束一个连接和压 Shift + Alt. 预览能包含详细数据相似的标题和阅读时间. 为了一些网页, AI 能也读取那页电文和产生键点. 那 AI 是最佳化的到读取和产生英语电文. 到按优先次序列出你的隐私, 那 AI 运行地方性地在你的计算机. <a data-l10n-name="connect">部分反馈</a>
    }

experimental-features-link-previews-description-no-ai =
    { PLATFORM() ->
        [macos] 到学习更多关于一个网页在...之前你单击, 盘旋结束一个连接和压 Shift (⇧) 正差 Option (⌥) 或 Alt. 预览能包含详细数据相似的标题和阅读时间. <a data-l10n-name="connect">部分反馈</a>
       *[other] 到学习更多关于一个网页在...之前你单击, 盘旋结束一个连接和压 Shift + Alt. 预览能包含详细数据相似的标题和阅读时间. <a data-l10n-name="connect">部分反馈</a>
    }

experimental-features-newtab-sections-follow-block =
    .label = 主题扇区和跟随/阻止为了新的 Tab 故事
experimental-features-newtab-sections-follow-block-description = 组织那故事在你的新的 Tab 页进入...之内主题扇区 (运动, 食物, 娱乐和更多) 为了一个更多结构的和容易的-to-scan 经历. 使用我们的新的跟随和阻止控制到定制什么内容你看见. <a data-l10n-name="connect">部分反馈</a>

experimental-features-fx-web-apps =
    .label = 添加位置到你的任务栏

experimental-features-fx-web-apps-description = 打开位置你频繁拜访作为一个网应用从你的任务栏. 一看为了那“添加标签页到任务栏”像标到那右那地址棒形图到使下水那位置在一个流线的窗口与全部的 { -brand-product-name }'s 保护. <a data-l10n-name="connect">部分反馈</a>


experimental-features-newtab-widget-lists =
    .label = 列表在 { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-new =
    .label = 列表
experimental-features-newtab-widget-lists-description = 保持你的到-do 列表 TOP协议-of-mind 何时你打开一个新的标签页. 从包装列表到买东西列表, 使你的计划在 { -brand-product-name }. <a data-l10n-name="connect">部分反馈</a>

experimental-features-newtab-widget-timer =
    .label = 计时器在 { -firefox-home-brand-name }
experimental-features-newtab-widget-timer-new =
    .label = 计时器
experimental-features-newtab-widget-timer-description = 日落一个计时器到保持你聚焦的, 用肘轻推你到制止在跟踪, 或提醒你到再充电. <a data-l10n-name="connect">部分反馈</a>

experimental-features-newtab-widget-lists-and-timer =
    .label = 列表和计时器在 { -firefox-home-brand-name }
experimental-features-newtab-widget-lists-and-timer-description = 保持你的到-do 列表 TOP协议-of-mind 何时你打开一个新的标签页. 从包装列表到买东西列表, 使你的计划在 { -brand-product-name }. 日落一个计时器到保持你聚焦的, 用肘轻推你到制止在跟踪, 或提醒你到再充电. <a data-l10n-name="connect">部分反馈</a>

experimental-features-newtab-widget-weather =
    .label = 天气趋势预测
experimental-features-newtab-widget-weather-description = 获得一个清除查看的 today's 天气与每小时的趋势预测. <a data-l10n-name="connect">部分反馈</a>

experimental-features-newtab-widget-picture-of-the-day =
    .label = 图象的那天
experimental-features-newtab-widget-picture-of-the-day-description = 添加一个一点点每日的奇迹到你的天. 获得一个新的图象, 学习某事有趣的, 和日落一个开始壁纸在一个子网访问协议. <a data-l10n-name="connect">部分反馈</a>

experimental-features-newtab-widget-clocks =
    .label = 时钟
experimental-features-newtab-widget-clocks-description = 添加向上的到四时钟与定制绰号到保持时间越过地方那事件到你. <a data-l10n-name="connect">均分反馈</a>

experimental-features-semantic-history-search =
    .label = 语义历史记录搜索
experimental-features-semantic-history-search-description = 使用一个本地的机器学习模型到提议登录项从历史记录那是讲述的到你的搜索立基于在白痴语言理解在那 { -brand-product-name } 地址棒形图. <a data-l10n-name="connect">部分反馈</a>

experimental-features-tab-notes =
    .label = Tab 笔记
experimental-features-tab-notes-description = Tab 笔记是一个实验的特性那出租屋你添加粘的笔记到你的浏览器标签页. 少量向下上下文, 提醒的人, 或近邻干扰步骤如此你能过来回和记住为什么你打开它. 我们将爱你的反馈作为我们保持有启发的这特性. <a data-l10n-name="connect">部分反馈</a>
